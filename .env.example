# Server Configuration
PORT=3001
NODE_ENV=development

# Authentication
JWT_SECRET=your-secure-jwt-secret-key-change-this
# To generate hash: npm run generate-hash yourpassword
# Or temporarily leave empty to allow "admin" password in development
ADMIN_PASSWORD_HASH=

# GitHub Persistence (Required for Vercel)
# Create a Personal Access Token (Classic) with 'repo' scope
GITHUB_TOKEN=ghp_your_github_token_here
GITHUB_OWNER=your_github_username
GITHUB_REPO=Updated_Portfolio
GITHUB_BRANCH=main # or v2_portfolio
GITHUB_DATA_PATH=server/data.json

# Image Upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Contact Form (Email)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password
CONTACT_TO_EMAIL=where-to-send-emails@example.com
