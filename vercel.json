{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend",
  "installCommand": "npm install && npm install --prefix client && npm install --prefix server",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
